# PortfolioSyncAgent Environment Variables Template
# Copy this file to .env and populate with your keys

# GitHub Personal Access Token (PAT)
# Required for API calls and repository push
GITHUB_TOKEN=your_github_token_here

# OpenAI API Key
# Required if LLM_PROVIDER is set to 'openai'
OPENAI_API_KEY=your_openai_api_key_here

# SMTP Authentication Settings (Required if approval.email.enabled is true)
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
